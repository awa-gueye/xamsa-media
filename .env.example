# Copiez ce fichier en .env et renseignez vos cles. Ne versionnez jamais .env.

# --- Assistant "Looy laaj ?" (chatbot IA + RAG) ---
# Fournisseur LLM : groq (recommande, free tier genereux), gemini, ou anthropic.
LLM_PROVIDER=groq

# Groq : cle gratuite sur https://console.groq.com/keys (tres rapide, Llama 3.3 70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini : cle gratuite sur https://aistudio.google.com/apikey
# (free tier aux quotas serres : si erreurs 429, preferez Groq ci-dessus)
# gemini-flash-lite-latest = le plus rapide. Evitez les noms versionnes (404 possible).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Recherche web (sources externes) via DuckDuckGo, sans cle. 1 = active, 0 = desactive.
WEB_SEARCH_ENABLED=1
ASSISTANT_MAX_WEB_RESULTS=4
ASSISTANT_MAX_SITE_RESULTS=5

# Optionnel, seulement si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Email (reinitialisation du mot de passe) ---
# Sans EMAIL_HOST, l'email s'affiche seulement dans le terminal (mode test).
# Pour un envoi reel via Gmail : activez la validation en 2 etapes sur votre
# compte Google, creez un "mot de passe d'application" (16 caracteres) sur
# https://myaccount.google.com/apppasswords, puis renseignez :
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=votreadresse@gmail.com
# EMAIL_HOST_PASSWORD=le_mot_de_passe_dapplication_16_caracteres
# (L'expediteur sera automatiquement votre adresse Gmail : arrive en boite de
#  reception, pas en spam. Testez avec : python manage.py sendtestemail vous@ex.com)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Django ---
# DJANGO_SECRET_KEY=
# DJANGO_DEBUG=1
